[
  {
    "id": "b1-01",
    "title": "咏鹅",
    "author": "骆宾王",
    "dynasty": "唐",
    "grade": "一年级上",
    "unit": "课文",
    "text": ["鹅，鹅，鹅，", "曲项向天歌。", "白毛浮绿水，", "红掌拨清波。"],
    "textType": "其他"
  },
  {
    "id": "b1-02",
    "title": "江南",
    "author": "汉乐府",
    "dynasty": "汉",
    "grade": "一年级上",
    "unit": "课文",
    "text": ["江南可采莲，", "莲叶何田田。", "鱼戏莲叶间。", "鱼戏莲叶东，", "鱼戏莲叶西，", "鱼戏莲叶南，", "鱼戏莲叶北。"],
    "textType": "其他"
  },
  {
    "id": "b1-03",
    "title": "画",
    "author": "王维",
    "dynasty": "唐",
    "grade": "一年级上",
    "unit": "课文",
    "text": ["远看山有色，", "近听水无声。", "春去花还在，", "人来鸟不惊。"],
    "textType": "其他"
  },
  {
    "id": "b1-04",
    "title": "悯农（其二）",
    "author": "李绅",
    "dynasty": "唐",
    "grade": "一年级上",
    "unit": "课文",
    "text": ["锄禾日当午，", "汗滴禾下土。", "谁知盘中餐，", "粒粒皆辛苦。"],
    "textType": "其他"
  },
  {
    "id": "b1-05",
    "title": "古朗月行（节选）",
    "author": "李白",
    "dynasty": "唐",
    "grade": "一年级上",
    "unit": "课文",
    "text": ["小时不识月，", "呼作白玉盘。", "又疑瑶台镜，", "飞在青云端。"],
    "textType": "其他"
  },
  {
    "id": "b1-06",
    "title": "风",
    "author": "李峤",
    "dynasty": "唐",
    "grade": "一年级上",
    "unit": "课文",
    "text": ["解落三秋叶，", "能开二月花。", "过江千尺浪，", "入竹万竿斜。"],
    "textType": "其他"
  },
  {
    "id": "b2-01",
    "title": "春晓",
    "author": "孟浩然",
    "dynasty": "唐",
    "grade": "一年级下",
    "unit": "课文",
    "text": ["春眠不觉晓，", "处处闻啼鸟。", "夜来风雨声，", "花落知多少。"],
    "textType": "其他"
  },
  {
    "id": "b2-02",
    "title": "赠汪伦",
    "author": "李白",
    "dynasty": "唐",
    "grade": "一年级下",
    "unit": "课文",
    "text": ["李白乘舟将欲行，", "忽闻岸上踏歌声。", "桃花潭水深千尺，", "不及汪伦送我情。"],
    "textType": "其他"
  },
  {
    "id": "b2-03",
    "title": "静夜思",
    "author": "李白",
    "dynasty": "唐",
    "grade": "一年级下",
    "unit": "课文",
    "text": ["床前明月光，", "疑是地上霜。", "举头望明月，", "低头思故乡。"],
    "textType": "其他"
  },
  {
    "id": "b2-04",
    "title": "寻隐者不遇",
    "author": "贾岛",
    "dynasty": "唐",
    "grade": "一年级下",
    "unit": "课文",
    "text": ["松下问童子，", "言师采药去。", "只在此山中，", "云深不知处。"],
    "textType": "其他"
  },
  {
    "id": "b2-05",
    "title": "池上",
    "author": "白居易",
    "dynasty": "唐",
    "grade": "一年级下",
    "unit": "课文",
    "text": ["小娃撑小艇，", "偷采白莲回。", "不解藏踪迹，", "浮萍一道开。"],
    "textType": "其他"
  },
  {
    "id": "b2-06",
    "title": "小池",
    "author": "杨万里",
    "dynasty": "宋",
    "grade": "一年级下",
    "unit": "课文",
    "text": ["泉眼无声惜细流，", "树阴照水爱晴柔。", "小荷才露尖尖角，", "早有蜻蜓立上头。"],
    "textType": "其他"
  },
  {
    "id": "b2-07",
    "title": "草",
    "author": "白居易",
    "dynasty": "唐",
    "grade": "一年级下",
    "unit": "课文",
    "text": ["离离原上草，", "一岁一枯荣。", "野火烧不尽，", "春风吹又生。"],
    "textType": "其他"
  },
  {
    "id": "b3-01",
    "title": "山行",
    "author": "杜牧",
    "dynasty": "唐",
    "grade": "三年级上",
    "unit": "第二单元",
    "text": ["远上寒山石径斜，", "白云生处有人家。", "停车坐爱枫林晚，", "霜叶红于二月花。"],
    "textType": "七言"
  },
  {
    "id": "b3-02",
    "title": "赠刘景文",
    "author": "苏轼",
    "dynasty": "宋",
    "grade": "三年级上",
    "unit": "第二单元",
    "text": ["荷尽已无擎雨盖，", "菊残犹有傲霜枝。", "一年好景君须记，", "最是橙黄橘绿时。"],
    "textType": "七言"
  },
  {
    "id": "b3-03",
    "title": "夜书所见",
    "author": "叶绍翁",
    "dynasty": "宋",
    "grade": "三年级上",
    "unit": "第二单元",
    "text": ["萧萧梧叶送寒声，", "江上秋风动客情。", "知有儿童挑促织，", "夜深篱落一灯明。"],
    "textType": "七言"
  },
  {
    "id": "b3-04",
    "title": "望天门山",
    "author": "李白",
    "dynasty": "唐",
    "grade": "三年级上",
    "unit": "第六单元",
    "text": ["天门中断楚江开，", "碧水东流至此回。", "两岸青山相对出，", "孤帆一片日边来。"],
    "textType": "七言"
  },
  {
    "id": "b3-05",
    "title": "饮湖上初晴后雨",
    "author": "苏轼",
    "dynasty": "宋",
    "grade": "三年级上",
    "unit": "第六单元",
    "text": ["水光潋滟晴方好，", "山色空蒙雨亦奇。", "欲把西湖比西子，", "淡妆浓抹总相宜。"],
    "textType": "七言"
  },
  {
    "id": "b3-06",
    "title": "望洞庭",
    "author": "刘禹锡",
    "dynasty": "唐",
    "grade": "三年级上",
    "unit": "第六单元",
    "text": ["湖光秋月两相和，", "潭面无风镜未磨。", "遥望洞庭山水翠，", "白银盘里一青螺。"],
    "textType": "七言"
  },
  {
    "id": "b4-01",
    "title": "绝句",
    "author": "杜甫",
    "dynasty": "唐",
    "grade": "三年级下",
    "unit": "第一单元",
    "text": ["两个黄鹂鸣翠柳，", "一行白鹭上青天。", "窗含西岭千秋雪，", "门泊东吴万里船。"],
    "textType": "七言"
  },
  {
    "id": "b4-02",
    "title": "惠崇春江晚景",
    "author": "苏轼",
    "dynasty": "宋",
    "grade": "三年级下",
    "unit": "第一单元",
    "text": ["竹外桃花三两枝，", "春江水暖鸭先知。", "蒌蒿满地芦芽短，", "正是河豚欲上时。"],
    "textType": "七言"
  },
  {
    "id": "b4-03",
    "title": "三衢道中",
    "author": "曾几",
    "dynasty": "宋",
    "grade": "三年级下",
    "unit": "第一单元",
    "text": ["梅子黄时日日晴，", "小溪泛尽却山行。", "绿阴不减来时路，", "添得黄鹂四五声。"],
    "textType": "七言"
  },
  {
    "id": "b4-04",
    "title": "元日",
    "author": "王安石",
    "dynasty": "宋",
    "grade": "三年级下",
    "unit": "第三单元",
    "text": ["爆竹声中一岁除，", "春风送暖入屠苏。", "千门万户曈曈日，", "总把新桃换旧符。"],
    "textType": "七言"
  },
  {
    "id": "b4-05",
    "title": "清明",
    "author": "杜牧",
    "dynasty": "唐",
    "grade": "三年级下",
    "unit": "第三单元",
    "text": ["清明时节雨纷纷，", "路上行人欲断魂。", "借问酒家何处有，", "牧童遥指杏花村。"],
    "textType": "七言"
  },
  {
    "id": "b4-06",
    "title": "九月九日忆山东兄弟",
    "author": "王维",
    "dynasty": "唐",
    "grade": "三年级下",
    "unit": "第三单元",
    "text": ["独在异乡为异客，", "每逢佳节倍思亲。", "遥知兄弟登高处，", "遍插茱萸少一人。"],
    "textType": "七言"
  },
  {
    "id": "b4-07",
    "title": "大林寺桃花",
    "author": "白居易",
    "dynasty": "唐",
    "grade": "三年级下",
    "unit": "第三单元",
    "text": ["人间四月芳菲尽，", "山寺桃花始盛开。", "长恨春归无觅处，", "不知转入此中来。"],
    "textType": "七言"
  },
  {
    "id": "b4-08",
    "title": "忆江南",
    "author": "白居易",
    "dynasty": "唐",
    "grade": "三年级下",
    "unit": "第三单元",
    "text": ["江南好，风景旧曾谙。", "日出江花红胜火，", "春来江水绿如蓝。", "能不忆江南？"],
    "textType": "其他"
  },
  {
    "id": "b4-09",
    "title": "守株待兔",
    "author": "韩非子",
    "dynasty": "先秦",
    "grade": "三年级下",
    "unit": "第二单元",
    "text": ["宋人有耕田者。", "田中有株，兔走触株，折颈而死。", "因释其耒而守株，冀复得兔。", "兔不可复得，而身为宋国笑。"],
    "textType": "其他"
  },
  {
    "id": "b5-01",
    "title": "浪淘沙",
    "author": "刘禹锡",
    "dynasty": "唐",
    "grade": "四年级上",
    "unit": "第一单元",
    "text": ["八月涛声吼地来，", "头高数丈触山回。", "须臾却入海门去，", "卷起沙堆似雪堆。"],
    "textType": "七言"
  },
  {
    "id": "b5-02",
    "title": "鹿柴",
    "author": "王维",
    "dynasty": "唐",
    "grade": "四年级上",
    "unit": "第一单元",
    "text": ["空山不见人，", "但闻人语响。", "返景入深林，", "复照青苔上。"],
    "textType": "五言"
  },
  {
    "id": "b5-03",
    "title": "暮江吟",
    "author": "白居易",
    "dynasty": "唐",
    "grade": "四年级上",
    "unit": "第九单元",
    "text": ["一道残阳铺水中，", "半江瑟瑟半江红。", "可怜九月初三夜，", "露似真珠月似弓。"],
    "textType": "七言"
  },
  {
    "id": "b5-04",
    "title": "题西林壁",
    "author": "苏轼",
    "dynasty": "宋",
    "grade": "四年级上",
    "unit": "第九单元",
    "text": ["横看成岭侧成峰，", "远近高低各不同。", "不识庐山真面目，", "只缘身在此山中。"],
    "textType": "七言"
  },
  {
    "id": "b5-05",
    "title": "雪梅",
    "author": "卢梅坡",
    "dynasty": "宋",
    "grade": "四年级上",
    "unit": "第九单元",
    "text": ["梅雪争春未肯降，", "骚人阁笔费评章。", "梅须逊雪三分白，", "雪却输梅一段香。"],
    "textType": "七言"
  },
  {
    "id": "b5-06",
    "title": "出塞",
    "author": "王昌龄",
    "dynasty": "唐",
    "grade": "四年级上",
    "unit": "第七单元",
    "text": ["秦时明月汉时关，", "万里长征人未还。", "但使龙城飞将在，", "不教胡马度阴山。"],
    "textType": "七言"
  },
  {
    "id": "b5-07",
    "title": "凉州词",
    "author": "王翰",
    "dynasty": "唐",
    "grade": "四年级上",
    "unit": "第七单元",
    "text": ["葡萄美酒夜光杯，", "欲饮琵琶马上催。", "醉卧沙场君莫笑，", "古来征战几人回？"],
    "textType": "七言"
  },
  {
    "id": "b6-01",
    "title": "四时田园杂兴（其二十五）",
    "author": "范成大",
    "dynasty": "宋",
    "grade": "四年级下",
    "unit": "第一单元",
    "text": ["梅子金黄杏子肥，", "麦花雪白菜花稀。", "日长篱落无人过，", "惟有蜻蜓蛱蝶飞。"],
    "textType": "七言"
  },
  {
    "id": "b6-02",
    "title": "宿新市徐公店",
    "author": "杨万里",
    "dynasty": "宋",
    "grade": "四年级下",
    "unit": "第一单元",
    "text": ["篱落疏疏一径深，", "树头新绿未成阴。", "儿童急走追黄蝶，", "飞入菜花无处寻。"],
    "textType": "七言"
  },
  {
    "id": "b6-03",
    "title": "清平乐·村居",
    "author": "辛弃疾",
    "dynasty": "宋",
    "grade": "四年级下",
    "unit": "第一单元",
    "text": ["茅檐低小，溪上青青草。", "醉里吴音相媚好，白发谁家翁媪？", "大儿锄豆溪东，中儿正织鸡笼。", "最喜小儿亡赖，溪头卧剥莲蓬。"],
    "textType": "其他"
  },
  {
    "id": "b6-04",
    "title": "蜂",
    "author": "罗隐",
    "dynasty": "唐",
    "grade": "四年级下",
    "unit": "第四单元",
    "text": ["不论平地与山尖，", "无限风光尽被占。", "采得百花成蜜后，", "为谁辛苦为谁甜？"],
    "textType": "七言"
  },
  {
    "id": "b6-05",
    "title": "独坐敬亭山",
    "author": "李白",
    "dynasty": "唐",
    "grade": "四年级下",
    "unit": "第七单元",
    "text": ["众鸟高飞尽，", "孤云独去闲。", "相看两不厌，", "只有敬亭山。"],
    "textType": "五言"
  },
  {
    "id": "b6-06",
    "title": "芙蓉楼送辛渐",
    "author": "王昌龄",
    "dynasty": "唐",
    "grade": "四年级下",
    "unit": "第七单元",
    "text": ["寒雨连江夜入吴，", "平明送客楚山孤。", "洛阳亲友如相问，", "一片冰心在玉壶。"],
    "textType": "七言"
  },
  {
    "id": "b6-07",
    "title": "塞下曲",
    "author": "卢纶",
    "dynasty": "唐",
    "grade": "四年级下",
    "unit": "第七单元",
    "text": ["月黑雁飞高，", "单于夜遁逃。", "欲将轻骑逐，", "大雪满弓刀。"],
    "textType": "五言"
  },
  {
    "id": "b6-08",
    "title": "墨梅",
    "author": "王冕",
    "dynasty": "元",
    "grade": "四年级下",
    "unit": "第七单元",
    "text": ["我家洗砚池头树，", "朵朵花开淡墨痕。", "不要人夸好颜色，", "只留清气满乾坤。"],
    "textType": "七言"
  },
  {
    "id": "b7-01",
    "title": "示儿",
    "author": "陆游",
    "dynasty": "宋",
    "grade": "五年级上",
    "unit": "第四单元",
    "text": ["死去元知万事空，", "但悲不见九州同。", "王师北定中原日，", "家祭无忘告乃翁。"],
    "textType": "七言"
  },
  {
    "id": "b7-02",
    "title": "题临安邸",
    "author": "林升",
    "dynasty": "宋",
    "grade": "五年级上",
    "unit": "第四单元",
    "text": ["山外青山楼外楼，", "西湖歌舞几时休？", "暖风熏得游人醉，", "直把杭州作汴州。"],
    "textType": "七言"
  },
  {
    "id": "b7-03",
    "title": "己亥杂诗",
    "author": "龚自珍",
    "dynasty": "清",
    "grade": "五年级上",
    "unit": "第四单元",
    "text": ["九州生气恃风雷，", "万马齐喑究可哀。", "我劝天公重抖擞，", "不拘一格降人才。"],
    "textType": "七言"
  },
  {
    "id": "b7-04",
    "title": "山居秋暝",
    "author": "王维",
    "dynasty": "唐",
    "grade": "五年级上",
    "unit": "第七单元",
    "text": ["空山新雨后，天气晚来秋。", "明月松间照，清泉石上流。", "竹喧归浣女，莲动下渔舟。", "随意春芳歇，王孙自可留。"],
    "textType": "五言"
  },
  {
    "id": "b7-05",
    "title": "枫桥夜泊",
    "author": "张继",
    "dynasty": "唐",
    "grade": "五年级上",
    "unit": "第七单元",
    "text": ["月落乌啼霜满天，", "江枫渔火对愁眠。", "姑苏城外寒山寺，", "夜半钟声到客船。"],
    "textType": "七言"
  },
  {
    "id": "b7-06",
    "title": "长相思",
    "author": "纳兰性德",
    "dynasty": "清",
    "grade": "五年级上",
    "unit": "第七单元",
    "text": ["山一程，水一程，", "身向榆关那畔行，", "夜深千帐灯。", "风一更，雪一更，", "聒碎乡心梦不成，", "故园无此声。"],
    "textType": "其他"
  },
  {
    "id": "b7-07",
    "title": "渔歌子",
    "author": "张志和",
    "dynasty": "唐",
    "grade": "五年级上",
    "unit": "第七单元",
    "text": ["西塞山前白鹭飞，", "桃花流水鳜鱼肥。", "青箬笠，绿蓑衣，", "斜风细雨不须归。"],
    "textType": "其他"
  },
  {
    "id": "b8-01",
    "title": "游子吟",
    "author": "孟郊",
    "dynasty": "唐",
    "grade": "五年级下",
    "unit": "第一单元",
    "text": ["慈母手中线，游子身上衣。", "临行密密缝，意恐迟迟归。", "谁言寸草心，报得三春晖。"],
    "textType": "五言"
  },
  {
    "id": "b8-02",
    "title": "鸟鸣涧",
    "author": "王维",
    "dynasty": "唐",
    "grade": "五年级下",
    "unit": "第一单元",
    "text": ["人闲桂花落，", "夜静春山空。", "月出惊山鸟，", "时鸣春涧中。"],
    "textType": "五言"
  },
  {
    "id": "b8-03",
    "title": "从军行",
    "author": "王昌龄",
    "dynasty": "唐",
    "grade": "五年级下",
    "unit": "第四单元",
    "text": ["青海长云暗雪山，", "孤城遥望玉门关。", "黄沙百战穿金甲，", "不破楼兰终不还。"],
    "textType": "七言"
  },
  {
    "id": "b8-04",
    "title": "送元二使安西",
    "author": "王维",
    "dynasty": "唐",
    "grade": "五年级下",
    "unit": "第四单元",
    "text": ["渭城朝雨浥轻尘，", "客舍青青柳色新。", "劝君更尽一杯酒，", "西出阳关无故人。"],
    "textType": "七言"
  },
  {
    "id": "b8-05",
    "title": "秋夜将晓出篱门迎凉有感",
    "author": "陆游",
    "dynasty": "宋",
    "grade": "五年级下",
    "unit": "第四单元",
    "text": ["三万里河东入海，", "五千仞岳上摩天。", "遗民泪尽胡尘里，", "南望王师又一年。"],
    "textType": "七言"
  },
  {
    "id": "b8-06",
    "title": "闻官军收河南河北",
    "author": "杜甫",
    "dynasty": "唐",
    "grade": "五年级下",
    "unit": "第四单元",
    "text": ["剑外忽传收蓟北，初闻涕泪满衣裳。", "却看妻子愁何在，漫卷诗书喜欲狂。", "白日放歌须纵酒，青春作伴好还乡。", "即从巴峡穿巫峡，便下襄阳向洛阳。"],
    "textType": "七言"
  },
  {
    "id": "b8-07",
    "title": "凉州词",
    "author": "王之涣",
    "dynasty": "唐",
    "grade": "五年级下",
    "unit": "第四单元",
    "text": ["黄河远上白云间，", "一片孤城万仞山。", "羌笛何须怨杨柳，", "春风不度玉门关。"],
    "textType": "七言"
  },
  {
    "id": "b9-01",
    "title": "宿建德江",
    "author": "孟浩然",
    "dynasty": "唐",
    "grade": "六年级上",
    "unit": "第一单元",
    "text": ["移舟泊烟渚，", "日暮客愁新。", "野旷天低树，", "江清月近人。"],
    "textType": "五言"
  },
  {
    "id": "b9-02",
    "title": "六月二十七日望湖楼醉书",
    "author": "苏轼",
    "dynasty": "宋",
    "grade": "六年级上",
    "unit": "第一单元",
    "text": ["黑云翻墨未遮山，", "白雨跳珠乱入船。", "卷地风来忽吹散，", "望湖楼下水如天。"],
    "textType": "七言"
  },
  {
    "id": "b9-03",
    "title": "西江月·夜行黄沙道中",
    "author": "辛弃疾",
    "dynasty": "宋",
    "grade": "六年级上",
    "unit": "第一单元",
    "text": ["明月别枝惊鹊，清风半夜鸣蝉。", "稻花香里说丰年，听取蛙声一片。", "七八个星天外，两三点雨山前。", "旧时茅店社林边，路转溪桥忽见。"],
    "textType": "其他"
  },
  {
    "id": "b9-04",
    "title": "过故人庄",
    "author": "孟浩然",
    "dynasty": "唐",
    "grade": "六年级上",
    "unit": "第一单元",
    "text": ["故人具鸡黍，邀我至田家。", "绿树村边合，青山郭外斜。", "开轩面场圃，把酒话桑麻。", "待到重阳日，还来就菊花。"],
    "textType": "五言"
  },
  {
    "id": "b9-05",
    "title": "春日",
    "author": "朱熹",
    "dynasty": "宋",
    "grade": "六年级上",
    "unit": "第三单元",
    "text": ["胜日寻芳泗水滨，", "无边光景一时新。", "等闲识得东风面，", "万紫千红总是春。"],
    "textType": "七言"
  },
  {
    "id": "b9-06",
    "title": "回乡偶书",
    "author": "贺知章",
    "dynasty": "唐",
    "grade": "六年级上",
    "unit": "第三单元",
    "text": ["少小离家老大回，", "乡音无改鬓毛衰。", "儿童相见不相识，", "笑问客从何处来。"],
    "textType": "七言"
  },
  {
    "id": "b9-07",
    "title": "七律·长征",
    "author": "毛泽东",
    "dynasty": "现代",
    "grade": "六年级上",
    "unit": "第二单元",
    "text": ["红军不怕远征难，万水千山只等闲。", "五岭逶迤腾细浪，乌蒙磅礴走泥丸。", "金沙水拍云崖暖，大渡桥横铁索寒。", "更喜岷山千里雪，三军过后尽开颜。"],
    "textType": "七言"
  },
  {
    "id": "b10-01",
    "title": "采薇",
    "author": "诗经",
    "dynasty": "先秦",
    "grade": "六年级下",
    "unit": "第一单元",
    "text": ["昔我往矣，杨柳依依。", "今我来思，雨雪霏霏。"],
    "textType": "其他"
  },
  {
    "id": "b10-02",
    "title": "早春呈水部张十八员外",
    "author": "韩愈",
    "dynasty": "唐",
    "grade": "六年级下",
    "unit": "第一单元",
    "text": ["天街小雨润如酥，", "草色遥看近却无。", "最是一年春好处，", "绝胜烟柳满皇都。"],
    "textType": "七言"
  },
  {
    "id": "b10-03",
    "title": "江上渔者",
    "author": "范仲淹",
    "dynasty": "宋",
    "grade": "六年级下",
    "unit": "第一单元",
    "text": ["江上往来人，", "但爱鲈鱼美。", "君看一叶舟，", "出没风波里。"],
    "textType": "五言"
  },
  {
    "id": "b10-04",
    "title": "泊船瓜洲",
    "author": "王安石",
    "dynasty": "宋",
    "grade": "六年级下",
    "unit": "第三单元",
    "text": ["京口瓜洲一水间，", "钟山只隔数重山。", "春风又绿江南岸，", "明月何时照我还？"],
    "textType": "七言"
  },
  {
    "id": "b10-05",
    "title": "游园不值",
    "author": "叶绍翁",
    "dynasty": "宋",
    "grade": "六年级下",
    "unit": "第三单元",
    "text": ["应怜屐齿印苍苔，", "小扣柴扉久不开。", "春色满园关不住，", "一枝红杏出墙来。"],
    "textType": "七言"
  },
  {
    "id": "b10-06",
    "title": "竹石",
    "author": "郑燮",
    "dynasty": "清",
    "grade": "六年级下",
    "unit": "第三单元",
    "text": ["咬定青山不放松，", "立根原在破岩中。", "千磨万击还坚劲，", "任尔东西南北风。"],
    "textType": "七言"
  }
]
